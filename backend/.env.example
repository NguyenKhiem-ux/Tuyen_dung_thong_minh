DATABASE_URL=sqlite:///./smart_recruitment.db
SECRET_KEY=change-this-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8
FRONTEND_ORIGIN=http://127.0.0.1:5173
ADMIN_EMAIL=admin@smartrecruit.ai
ADMIN_PASSWORD=Admin@123
# Engine AI (tùy chọn)
# Trọng số điểm: kỹ năng,kinh nghiệm,ngữ nghĩa,dự án (tổng = 1). Để trống = 0.4,0.25,0.2,0.15
AI_WEIGHTS=
# Tự đọc CV dạng ảnh/scan bằng Tesseract nếu máy có cài
AI_OCR=true
AI_OCR_LANGS=eng+vie
