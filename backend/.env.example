# SQLite paths are resolved from backend/, never from the shell working directory.
DATABASE_URL=sqlite:///./smart_recruitment.db
DATABASE_ALLOW_CREATE=false

# PostgreSQL example only; obtain real values from the team secret manager.
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<database>

SECRET_KEY=replace-with-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=1440
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=8

# CORS origins must be exact origins (scheme + host + optional port), with no trailing slash.
FRONTEND_ORIGIN=http://127.0.0.1:5173
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:4173","http://127.0.0.1:4173"]

ADMIN_EMAIL=admin@smartrecruit.ai
ADMIN_PASSWORD=replace-only-for-a-disposable-demo-database
ALLOW_DEMO_SEED=false

AI_WEIGHTS=
AI_OCR=true
AI_OCR_LANGS=eng+vie
AI_RECOMMENDATION_CANDIDATE_LIMIT=20
